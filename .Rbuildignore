^renv$
^renv\.lock$
^\.Rprofile$
^.*\.Rproj$
^\.Rproj\.user$
^\.gitignore$
^\.github$
^README\.Rmd$
^pkgdown$
^_pkgdown\.yml$
^docs$
^Dockerfile$
^\.dockerignore$
^physio-ecosystem$
^AGENTS\.md$
^inst/gui/node_modules$
^inst/gui/\.nvmrc$
^inst/gui/\.git.*$
^CONTRIBUTING\.md$
^CITATION\.cff$
^codemeta\.json$
# This directory is both the foundation package and the monorepo root, so the
# build has to exclude the working-tree material that lives alongside it.
# `sync_public.sh` publishes via `git archive` and is unaffected by any of this,
# but `R CMD build` would otherwise sweep in hundreds of megabytes of untracked
# files and fail the portable-file-names check.
^\.venv$
^\.worktrees$
^\.githooks$
^gitpage$
^scripts$
^build$
^Rplots\.pdf$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.zenodo\.json$
